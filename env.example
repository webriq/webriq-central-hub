# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Service role key — server-only, never expose to the client
SUPABASE_SECRET_KEY=your-secret-key

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Anthropic — default provider for all layers
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional, switch any layer to OpenAI via llm_config.provider='openai'
# Found in: platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# ─── App ──────────────────────────────────────────────────────────────────────
# Set to your production domain (e.g. https://hub.webriqs.com) in .env.local.
# Used in invite emails as the redirectTo base URL. Must also be added to
# Supabase Dashboard → Auth → URL Configuration → Allowed Redirect URLs.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ─── Zoho ─────────────────────────────────────────────────────────────────────
# OAuth 2.0 credentials for Zoho Projects, Desk, and Cliq (Sprint 2+)
# These same credentials are entered in Supabase Dashboard (Auth → Providers → Custom → zoho)
# to enable "Sign in with Zoho". Supabase callback URI: https://[project-ref].supabase.co/auth/v1/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho Projects portal ID (numeric) — used in API calls
# Found in: Zoho Projects → Settings → Portal Details
ZOHO_PORTAL_ID=
# Zoho Projects portal name (slug) — used for web URL construction (NEXT_PUBLIC = safe for client)
# Find it in your Zoho Projects URL: https://projects.zoho.com/portal/{name}/
NEXT_PUBLIC_ZOHO_PORTAL_NAME=
# Base URL for your Zoho org (e.g. https://projectsapi.zoho.com)
ZOHO_API_BASE_URL=
# Zoho Desk organization ID (numeric) — sent as the required "orgId" header on every Desk API call.
# Found in: Zoho Desk → Setup → Developer Space → API.
#
# OAuth scopes the Hub's Desk features need on ZOHO_REFRESH_TOKEN (scopes are locked at
# token-creation time — adding one means regenerating the refresh token from the Self Client
# at api-console.zoho.com; a missing scope returns 403 SCOPE_MISMATCH):
#   Desk.tickets.READ, Desk.tickets.UPDATE   — ticket export / status sync / cf enrichment (task 329)
#   Desk.contacts.READ, Desk.accounts.READ   — contact + account/company matching (task 117)
#   Desk.agents.READ                          — ticket owner names
#   Desk.search.READ, Desk.departments.READ   — Archived Tickets export (task 325)
#   Desk.articles.READ, Desk.settings.READ    — Knowledge Base export (task 336; settings only for categories)
ZOHO_DESK_ORG_ID=

# ─── Sanity (Sprint 5+) ───────────────────────────────────────────────────────
# Sanity API token (editor access) — project ID is stored per customer_products row
SANITY_API_TOKEN=
# Robot account (automation@webriq.com) — Editor on all Sanity client projects
# Setup: create account → add to projects → generate token from sanity.io/manage
SANITY_GLOBAL_TOKEN=
# Sanity Presentation Tool preview secret (2hr expiry for draft preview URLs)
SANITY_PREVIEW_SECRET=

# ─── GitHub (Sprint 5+) ───────────────────────────────────────────────────────
# Fine-grained PAT with repo read/write for PR creation
GITHUB_TOKEN=

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Used for outbound invite/OTP email only (src/lib/email/resend.ts). Ticketing email
# (inbound intake + outbound replies, tasks 303/316) moved to the Zoho Mail API — see
# "Ticketing email (Zoho Mail)" below — by task 318.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Ticketing email (Zoho Mail API) ──────────────────────────────────────────
# Task 318 — replaces Resend as the provider behind task 303 (inbound) and task 316
# (outbound reply). helpdesk@webriq.us already lives in Zoho Mail; this polls/sends against
# Zoho Mail's own REST API instead of a third-party provider.
#
# Reuses ZOHO_CLIENT_ID/ZOHO_CLIENT_SECRET above (Projects/Desk) — Zoho allows only one Self
# Client per account, so there is no separate "Mail" client to register. Only the refresh
# token is Mail-specific (ZOHO_MAIL_REFRESH_TOKEN): generate an additional authorization code
# from the *same* Self Client at api-console.zoho.com scoped to
# ZohoMail.messages.ALL,ZohoMail.accounts.READ,ZohoMail.folders.READ, then exchange it for a
# refresh token. This does not affect or replace the existing ZOHO_REFRESH_TOKEN — each code
# exchange mints an independent token off the same client.
ZOHO_MAIL_REFRESH_TOKEN=
# Zoho Mail's internal numeric ID for the helpdesk@webriq.us mailbox — one-time lookup:
# GET https://mail.zoho.com/api/accounts (with an access token minted from the refresh token
# above).
ZOHO_MAIL_ACCOUNT_ID=
# Inbox folder's internal ID for the same mailbox — one-time lookup:
# GET https://mail.zoho.com/api/accounts/{ZOHO_MAIL_ACCOUNT_ID}/folders
ZOHO_MAIL_INBOX_FOLDER_ID=
# API host — differs by Zoho data center (.com / .eu / .in / .com.cn / .com.au). Confirm which
# one webriq.us's Zoho org runs on before setting. Defaults to https://mail.zoho.com.
ZOHO_MAIL_API_BASE_URL=
# The mailbox's actual sending address, helpdesk@webriq.us — used as the Zoho Mail
# "fromAddress" on customer-facing replies (task 316). Distinct from ZOHO_MAIL_ACCOUNT_ID
# (Zoho's internal numeric ID) and from RESEND_FROM_EMAIL (unrelated, invite/OTP only).
ZOHO_MAIL_FROM_ADDRESS=

# ─── Ticketing email inline images (IMAP, task 321) ──────────────────────────
# Zoho Mail's REST API (above) does not expose inline (cid-referenced) images as fetchable
# attachments — verified empirically (empty attachments array on messages with real inline
# images), and the ImageDisplay URL its HTML body references only accepts an interactive Zoho
# Mail webclient session, not an OAuth API token (confirmed: rejects our token with a redirect
# to Zoho's login page). Workaround: pull the raw MIME message via IMAP instead — inline images
# come through as real bytes keyed by Content-ID, no session-cookie problem. Read-only: no send,
# no delete, no flag mutation.
#
# Enable first: Zoho Mail (as helpdesk@webriq.us) -> Settings -> Mail Accounts -> POP/IMAP
# Access -> check "IMAP Access".
ZOHO_MAIL_IMAP_HOST=imappro.zoho.com
ZOHO_MAIL_IMAP_PORT=993
# App-specific password (NOT the account login password) — generate at accounts.zoho.com ->
# Security -> App Passwords, logged in as helpdesk@webriq.us. Shown once at creation only.
ZOHO_MAIL_IMAP_APP_PASSWORD=
# No separate IMAP username var — reuses ZOHO_MAIL_FROM_ADDRESS above (Zoho IMAP auth uses the
# full email address).

# ─── Webhook security (Sprint 2+) ────────────────────────────────────────────
# HMAC key from Zoho Projects → Settings → Automation → Webhooks → Security Settings.
# Zoho signs the raw POST body with HMAC-SHA256 and sends it in X-ZP-WEBHOOK-SIGNATURE (base64).
ZOHO_WEBHOOK_SECRET=

# ─── StackShift Order Form intake (task 347) ─────────────────────────────────
# Shared secret between the webriq.com server-side proxy route and the Hub intake endpoints
# POST /api/webhooks/stackshift-order[/uploads]. The proxy sends it in the
# x-stackshift-webhook-secret header (timing-safe compared). Generate with: openssl rand -hex 32
# Set the SAME value in the webriq.com deployment env. Absent → the endpoint returns 503.
STACKSHIFT_ORDER_WEBHOOK_SECRET=
# Comma-separated fixed recipients notified on every submission, on top of every PM's email
# (resolved from auth.users ∩ profiles.role='pm'). e.g. philippe@webriq.com,danielle@webriq.com
STACKSHIFT_ORDER_NOTIFY_EMAILS=

# ─── Cron job security (Sprint 3+) ────────────────────────────────────────────
# Shared secret between pg_cron (Supabase) and every cron-triggered route: /api/digest,
# /api/kb/lint, /api/admin/zoho-sync/tasklists, /api/programme/reminders,
# /api/onboarding/scheduled-autostart, /api/cron/email-poll (task 318). Renamed from
# DIGEST_SECRET — that name stopped being
# accurate once routes beyond the digest started sharing it (migration 078).
# Cron jobs read this via a Supabase Vault secret named `cron_secret_key` (see migrations
# 077/078), not directly from this env var — set the same value in both places.
CRONJOB_SECRET_KEY=

# ─── QStash (chat follow-up to task 157) ──────────────────────────────────────
# One-shot, exact-time scheduled onboarding start — fires at the scheduled instant instead of
# waiting for the next cron poll tick. Copy all three from the Upstash console (console.upstash.com/qstash).
# The cron poll (onboarding-scheduled-autostart) stays as a fallback in case a QStash delivery fails.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Required if your QStash token/user was created under a specific region (e.g. us-east-1) — the
# global endpoint's auto-routing does not reliably resolve to your account's actual home region,
# and calling it from a different region returns "user not found in this region". Set this to
# match wherever you created your token in the Upstash console, e.g.:
# QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_URL=

# ─── Reply route security (Sprint 5+) ────────────────────────────────────────
REPLY_SECRET=                    # Shared secret for POST /api/reply (internal route); generate with: openssl rand -hex 32

# ─── Zoho Cliq channels (Sprint 3+) ──────────────────────────────────────────
# PM digest and general notifications (set in Sprint 2)
# ZOHO_CLIQ_WEBHOOK_URL and ZOHO_CLIQ_WEBHOOK_TOKEN defined above under Zoho section
# Separate channel for dev digest notifications
ZOHO_CLIQ_DEV_WEBHOOK_URL=

# ─── Push Notifications ──────────────────────────────────────────────────────
# Generate VAPID keys: node -e "const webpush = require('web-push'); console.log(webpush.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=                    # server-side signing key
VAPID_PRIVATE_KEY=                   # server-side — never expose to client
NEXT_PUBLIC_VAPID_PUBLIC_KEY=        # same value as VAPID_PUBLIC_KEY — exposed to browser for PushManager.subscribe()

# ─── Email / SMTP (task 085+) ─────────────────────────────────────────────────
MAIL_FROM=info@dxpstudio.webriq.com
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=587
MAIL_USER=emailapikey
MAIL_PASS=your-zeptomail-api-key

# ─── Vercel AI Gateway (optional proxy) ──────────────────────────────────────
# Routes AI requests through Vercel's gateway for caching and unified billing.
# Supabase llm_invocation_logs remains the source of truth for per-customer cost attribution.
# Found in: vercel.com/{team}/~/ai-gateway
VERCEL_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_TOKEN=
